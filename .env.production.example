# Production is disabled until real adapters, signing and policy approvals are configured.
NODE_ENV=production
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27027/haatgo_local?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
QUEUE_MODE=redis
DUMMY_PROVIDERS=false
DUMMY_OTP=123456
DUMMY_DELIVERY_OTP=654321
ADMIN_EMAIL=admin@haatgo.local
ADMIN_PASSWORD=HaatGo-demo-2026!
SESSION_SECRET=local-development-only-change-before-any-deployment
CUSTOMER_WEB_ORIGIN=http://localhost:5173
ADMIN_WEB_ORIGIN=http://localhost:5174
ONLINE_PAYMENTS_ENABLED=true
MAP_PROVIDER=osm
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional real catalogue media, independent of dummy OTP/payment providers.
MEDIA_PROVIDER=disabled
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_ASSET_ROOT=haatgo

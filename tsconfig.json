  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "resolveJsonModule": true,
    "outDir": "dist", "skipLibCheck": true, "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "worker/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
